rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthed() && request.auth.token.email in ["lily.studyroom@gmail.com", "contact.studyroomaustralia@gmail.com"];
    }

    function roleDoc() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid));
    }

    function role() {
      return isAuthed() ? roleDoc().data.role : null;
    }

    function isTutor() {
      return isAuthed() && role() == "tutor";
    }

    function isTutorOrAdmin() {
      return isAuthed() && (isAdmin() || role() in ["tutor", "admin"]);
    }

    function authedEmail() {
      return isAuthed() ? request.auth.token.email : null;
    }

    function isAssignedTutorDoc(docData) {
      return isAuthed() && (
        (docData.assignedTutorId != null && docData.assignedTutorId == request.auth.uid) ||
        (docData.assignedTutorEmail != null && authedEmail() != null && docData.assignedTutorEmail == authedEmail())
      );
    }

    function sessionTutorMatch(sessionData) {
      return isAuthed() && (
        isAdmin() ||
        (sessionData.tutorId != null && sessionData.tutorId == request.auth.uid) ||
        (sessionData.tutorEmail != null && authedEmail() != null && sessionData.tutorEmail == authedEmail())
      );
    }

    function tutorOwnerMatch(docData) {
      return isAuthed() && (
        isAdmin() ||
        (docData.tutorId != null && docData.tutorId == request.auth.uid) ||
        (docData.tutorEmail != null && authedEmail() != null && docData.tutorEmail == authedEmail())
      );
    }

    // ---------------- ROOMS ----------------
    match /rooms/{roomId} {
      allow read: if isAuthed();

      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly([
          "title","createdBy","createdAt","lastActiveAt","isActive","participantCount"
        ])
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthed()
        && request.resource.data.keys().hasOnly([
          "title","createdBy","createdAt","lastActiveAt","isActive","participantCount"
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.title == resource.data.title
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "lastActiveAt","isActive","participantCount"
        ]);

      allow delete: if false;

      match /chat/{msgId} {
        allow read: if isAuthed();

        allow create: if isAuthed()
          && request.resource.data.uid == request.auth.uid
          && (
            !("email" in request.resource.data)
            || request.resource.data.email == null
            || (authedEmail() != null && request.resource.data.email == authedEmail())
          )
          && request.resource.data.keys().hasOnly([
            "uid","email","name","text","fileUrl","fileName","createdAt"
          ])
          && (!("text" in request.resource.data) || request.resource.data.text.size() <= 2000)
          && (!("fileUrl" in request.resource.data) || request.resource.data.fileUrl == null
              || request.resource.data.fileUrl.size() <= 300)
          && (!("fileName" in request.resource.data) || request.resource.data.fileName == null
              || request.resource.data.fileName.size() <= 200);

        allow delete: if isAuthed() && (
          resource.data.uid == request.auth.uid || isTutorOrAdmin()
        );

        allow update: if false;
      }

      match /whiteboard/{strokeId} {
        allow read, write: if isAuthed();
      }
    }

    // ---------------- USERS + SUBCOLLECTIONS ----------------
    match /users/{uid} {
      allow read: if isSelf(uid) || isTutorOrAdmin();
      allow create: if isSelf(uid);
      // Admin can correct a tutor's identity/profile fields (name, bio, etc.)
      // from the admin Tutors UI — this was previously self-only, which
      // silently broke the existing admin "Edit" panel's client-side
      // updateDoc call (pre-publish identity audit).
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if false;

      match /pomoState/{docId} {
        allow read, create, update, delete: if isSelf(uid) || isAdmin();
      }

      match /tasks/{taskId} {
        allow read: if isSelf(uid) || isTutorOrAdmin();
        allow create, update: if isSelf(uid) || isTutor() || isAdmin();
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /pomoSessions/{pomoId} {
        allow read, create, update, delete: if isSelf(uid) || isAdmin();
      }

      match /pomoHistory/{pomoId} {
        allow read, create, update, delete: if isSelf(uid) || isAdmin();
      }

      match /moodLogs/{logId} {
        allow read: if isSelf(uid) || isTutorOrAdmin();
        allow create, update, delete: if isSelf(uid);
      }

      match /upcoming/{itemId} {
        allow read: if isSelf(uid) || isTutorOrAdmin();
        allow create, update, delete: if isSelf(uid);
      }

      match /upcoming/{assessmentId}/checkpoints/{checkpointId} {
        allow read, create, update, delete: if isSelf(uid);
      }

      match /streak/{docId} {
        allow read: if isSelf(uid) || isTutorOrAdmin();
        allow create, update: if isSelf(uid) || isAdmin();
        allow delete: if false;
      }
    }

    // ---------------- ROLES ----------------
    match /roles/{uid} {
      allow read: if isSelf(uid) || isTutorOrAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(["role"])
        && request.resource.data.role in ["student", "parent", "tutor_pending"];

      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(["role"])
        && request.resource.data.role == resource.data.role;

      allow delete: if false;

      allow write: if isAdmin();
    }

    // ---------------- REPORTS ----------------
    match /reports/{reportId} {
      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly([
          "roomId","messageId","reportedBy",
          "messageText","messageOwnerId","reason","createdAt"
        ]);
      allow read: if isTutorOrAdmin();
      allow update, delete: if false;
    }

    // ---------------- LEADS ----------------
    match /leads/{leadId} {
      allow read, write: if isAdmin();

      // Tutors can read unclaimed leads or leads they have claimed
      allow read: if isTutor() && (
        (resource.data.status == "new" && resource.data.claimedTutorId == null) ||
        (resource.data.claimedTutorId != null && resource.data.claimedTutorId == request.auth.uid)
      );

      // Direct tutor self-claim is intentionally not permitted here (Release 1A,
      // Stage 2). Assignment only happens via the request -> admin-assigns flow:
      // a tutor requests via leads/{leadId}/tutorRequests (Admin SDK, see
      // /api/leads/[leadsId]/request), and an admin/ops assigns claimedTutorId /
      // assignedTutorId through the Admin SDK, which bypasses these rules.
      allow update: if false;

      allow create, delete: if false;
    }

    // ---------------- ENQUIRIES ----------------
    match /enquiries/{enquiryId} {
      allow read, write: if isTutorOrAdmin();
    }

    // ---------------- CLIENTS ----------------
    match /clients/{clientId} {
      allow read: if isAdmin();
      allow read: if isTutor() && isAssignedTutorDoc(resource.data);

      // Multi-student-family correction (pre-Stage-6): a client can have
      // several students, each with their own assigned tutor. The single
      // assignedTutorId/assignedTutorEmail check above can only ever
      // represent ONE tutor at a time, so assignedTutorIds — a derived array
      // of every tutor currently assigned to at least one student under this
      // client, recomputed from the students collection whenever a tutor
      // assignment changes (see clientTutorSync.ts) — is checked here too.
      // This never grants access to an unrelated family; it only widens who
      // among this family's own assigned tutors can read it.
      allow read: if isTutor()
        && resource.data.assignedTutorIds is list
        && request.auth.uid in resource.data.assignedTutorIds;

      // Parent can read their own client record by email match
      allow read: if isAuthed()
        && resource.data.parentEmail != null
        && authedEmail() != null
        && resource.data.parentEmail == authedEmail();

      // Fixed post-Release-1B (pre-publish audit): `diff()` is only valid
      // against an existing document, so a `write` rule built around
      // `request.resource.data.diff(resource.data)` can never evaluate true
      // for a create (resource.data doesn't exist yet) — combined with the
      // "allow create, delete: if false" line this used to sit next to, it
      // meant admin could no longer create a client document from the
      // browser at all, even though that's exactly what Add Existing
      // Student and lead-to-client conversion both still do
      // (add-existing/page.tsx's addDoc, leads/[leadId]/page.tsx's
      // batch.set on a brand-new clientId). Split into a `create` and an
      // `update` rule so each is checked in the request type it actually
      // applies to.

      // Admin can create a brand-new client doc directly from the browser.
      // A freshly created client can never legitimately already carry a
      // discountPreference* value (those are only ever set afterwards, via
      // the dedicated server route below) — checking the created document's
      // own keys is the create-time equivalent of the update-time diff()
      // check just below.
      allow create: if isAdmin()
        && !request.resource.data.keys().hasAny([
          "discountPreferenceType", "discountPreferenceValue",
          "discountPreferenceReason", "discountPreferenceUpdatedBy", "discountPreferenceUpdatedAt"
        ]);

      // Admin keeps client-side write for ordinary fields on an existing
      // client (parent info, admin notes, End/Restore family, tutor-mirror
      // sync), but the five discountPreference* fields are carved out of
      // that grant — they can only be changed via
      // POST /api/clients/[clientId]/discount-preference (Admin SDK).
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "discountPreferenceType", "discountPreferenceValue",
          "discountPreferenceReason", "discountPreferenceUpdatedBy", "discountPreferenceUpdatedAt"
        ]);

      allow update: if isTutor()
        && isAssignedTutorDoc(resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "tutorNotes","updatedAt"
        ]);

      // Guarded permanent delete (admin/clients/[clientId]/page.tsx) is a
      // real, client-side, intentionally-rare action — the app already
      // refuses to call it for any client with real session/package
      // history. The rule only needs to gate it to admin, same as every
      // other guarded permanent-delete in this file (students, leads).
      allow delete: if isAdmin();
    }

    // ---------------- STUDENTS ----------------
    match /students/{studentId} {
      allow read, write: if isAdmin();
      allow read: if isTutor() && isAssignedTutorDoc(resource.data);

      // Parent can read their linked student record
      allow read: if isAuthed()
        && resource.data.hubUid != null
        && (
          (resource.data.hubEmail != null && authedEmail() != null && resource.data.hubEmail == authedEmail()) ||
          isSelf(resource.data.hubUid)
        );

      allow update: if isTutor()
        && isAssignedTutorDoc(resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "tutorConfirmedAt","tutorConfirmedBy","hubUid","hubEmail","updatedAt"
        ]);

      allow create, delete: if false;

      match /sessions/{noteId} {
        allow read, write: if isAdmin();

        allow read, create, update: if isTutor()
          && isAssignedTutorDoc(
            get(/databases/$(database)/documents/students/$(studentId)).data
          );

        allow delete: if false;
      }
    }

    // ---------------- TOP-LEVEL SESSIONS ----------------
    match /sessions/{sessionId} {
      allow read, write: if isAdmin();
      allow read: if isTutor() && sessionTutorMatch(resource.data);

      // Student can read their own sessions
      allow read: if isAuthed()
        && resource.data.studentId != null
        && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.hubUid == request.auth.uid;

      // Parent can read sessions for their student
      allow read: if isAuthed()
        && resource.data.clientId != null
        && exists(/databases/$(database)/documents/clients/$(resource.data.clientId))
        && get(/databases/$(database)/documents/clients/$(resource.data.clientId)).data.parentEmail == authedEmail();

      // Release 1A, Stage 3: new sessions must be exactly 60 minutes, in_home
      // or online only (no group), and must carry an immutable originalStartAt
      // that matches startAt at creation time — this is what locks casual
      // pricing to the session's original booked date rather than whatever
      // startAt later becomes after a reschedule. originalStartAt is never in
      // the tutor update allowlist below, so it can never be changed once set.
      allow create: if isTutor()
        && request.resource.data.tutorId == request.auth.uid
        && (
          !("tutorEmail" in request.resource.data) ||
          request.resource.data.tutorEmail == null ||
          request.resource.data.tutorEmail == authedEmail()
        )
        && request.resource.data.keys().hasOnly([
          "tutorId","tutorEmail","studentId","clientId","planId",
          "startAt","endAt","originalStartAt","durationMinutes","durationMins",
          "modality","mode","status","legacyStatus","seriesKey",
          "notes","createdAt","updatedAt"
        ])
        && request.resource.data.status == "scheduled"
        && request.resource.data.originalStartAt == request.resource.data.startAt
        && request.resource.data.durationMinutes == 60
        && request.resource.data.durationMins == 60
        && request.resource.data.mode in ["in_home", "online"]
        && request.resource.data.modality in ["IN_HOME", "ONLINE"];

      // Tutors can update session details, notes, and unit plan / worksheet links
      allow update: if isTutor()
        && sessionTutorMatch(resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "startAt","endAt","notes","unitPlanWeek","worksheetId","updatedAt"
        ]);

      allow delete: if false;

      match /logs/{logId} {
        allow read, write: if isAdmin();

        allow read, create, update: if isTutor()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.tutorId == request.auth.uid;

        // Student can read logs on their own sessions
        allow read: if isAuthed()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentId != null
          && get(/databases/$(database)/documents/students/$(
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentId
          )).data.hubUid == request.auth.uid;

        // Parent can read logs for their client's sessions
        allow read: if isAuthed()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.clientId != null
          && get(/databases/$(database)/documents/clients/$(
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.clientId
          )).data.parentEmail == authedEmail();

        allow delete: if false;
      }
    }

    // ---------------- INVOICES ----------------
    // NOTE: Invoice writes (create/update) are performed server-side via the
    // Firebase Admin SDK (serverBilling.ts, push-invoice-to-xero, etc.) which
    // bypasses these client security rules entirely. Release 1B, Stage 4:
    // removed the previous "allow read, write: if isAdmin()" blanket bypass —
    // admin keeps client-side read only; every write (including admin's) must
    // go through an authenticated Admin-SDK server route.
    match /invoices/{invoiceId} {
      allow read: if isAdmin();
      allow read: if isTutor() && tutorOwnerMatch(resource.data);
      allow write: if false;
    }

    // ---------------- PLANS ----------------
    // Release 1B, Stage 4: same tightening as invoices — admin reads
    // client-side, but plan creation/renewal/discount/correction all go
    // through /api/plans/* server routes (Admin SDK), never a client write.
    match /plans/{planId} {
      allow read: if isAdmin();
      allow read: if isTutor() && tutorOwnerMatch(resource.data);
      allow write: if false;
    }

    // ---------------- ENTITLEMENTS ----------------
    // Release 1B, Stage 4: same tightening — entitlement balances (including
    // admin corrections) are only ever written via server routes.
    match /entitlements/{entitlementId} {
      allow read: if isAdmin();
      allow read: if isTutor() && tutorOwnerMatch(resource.data);
      allow write: if false;

      // Release 1B addendum: audit trail for admin balance corrections.
      // Admin can read it (to show correction history); it is only ever
      // written by POST /api/entitlements/[planId]/correct (Admin SDK).
      match /corrections/{correctionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ---------------- SETTINGS (Release 1B) ----------------
    // Canonical current package pricing (settings/packagePricing) and any
    // future admin-config docs under this collection. Admin reads client-side
    // to display current values; the only way to change one is the matching
    // authenticated Admin-SDK server route (e.g. POST /api/settings/package-pricing).
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------- ACTION DISMISSALS (Release 1B, final polish) ----------------
    // Persisted dismissal of an Operations Centre "Action Required" row. This is
    // operational preference, not commercial/history data — dismissing never
    // deletes or alters the underlying session/invoice/package/student/lead doc,
    // it only hides a derived row from the normal view. Narrow, explicit
    // exception to the "derived-only, no persisted task state" MVP rule.
    match /actionDismissals/{key} {
      allow read, write: if isAdmin();
    }

    // ---------------- TUTOR HANDOVERS (Release 1B.1) ----------------
    // Structured handover packet (student/parent details, availability,
    // suggested next steps) — created ONLY by the admin-only, server-side
    // POST /api/tutors/handover/confirm action, deliberately separate from
    // (and later than) the existing tutor-assignment write. Doc ID ==
    // studentId. Only the assigned tutor on this specific handover may read
    // it — never a different/unrelated tutor — and that tutor may only ever
    // change their own status/statusUpdatedBy/statusUpdatedAt fields
    // (Contacted parent / First session booked / Need admin help), never any
    // of the family-detail fields.
    match /tutorHandovers/{studentId} {
      allow read, create, delete: if isAdmin();
      allow update: if isAdmin();
      allow read: if isTutor() && resource.data.tutorId == request.auth.uid;
      allow update: if isTutor()
        && resource.data.tutorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "statusUpdatedBy", "statusUpdatedAt"]);
    }

    // ---------------- PACKAGES ----------------
    match /packages/{packageId} {
      allow read, write: if isAdmin();

      allow read: if isTutor() && resource.data.assignedTutorId == request.auth.uid;

      allow update: if isTutor()
        && resource.data.assignedTutorId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "sessionsUsed","sessionsRemaining","status","updatedAt"
        ]);

      allow create, delete: if false;
    }

    // ---------------- INTEGRATIONS ----------------
    match /integrations/{docId} {
      allow read, write: if isAdmin();
    }

    // ---------------- studentPlans ----------------
    match /studentPlans/{studentId} {
      allow read, write: if isTutorOrAdmin();
    }

    // ---------------- TUTOR PROFILE + PRIVATE DATA ----------------
    // Tutor Profile V2.
    // Tutors may read their own top-level profile document.
    // Tutors must update the profile through a validated server API route
    // using the Admin SDK; they cannot write the top-level profile directly.
    match /tutors/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Existing tutor-owned subcollections.
    // These explicit rules preserve the previous wildcard behaviour for the
    // known active subcollections while allowing internal/admin to stay private.
    match /tutors/{uid}/studentPlans/{docId} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    match /tutors/{uid}/worksheets/{docId} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    match /tutors/{uid}/sessionNotes/{docId} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    // Admin-only internal tutor record.
    // Tutors cannot read or write this document.
    match /tutors/{uid}/internal/{docId} {
      allow read, write: if isAdmin();
    }

    // ---------------- TUTOR ACCESS CODES ----------------
    match /tutorAccessCodes/{codeId} {
      allow read, write: if isAdmin();
    }

    // ---------------- BLOG POSTS ----------------
    match /blogPosts/{slug} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

       // ---------------- PROMO CODES ----------------
    // Admin can read and write all promo codes.
    // Redemption happens server-side via Admin SDK.
    match /promoCodes/{codeId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------- BETA FEEDBACK ----------------
    match /betaFeedback/{docId} {
      allow create: if isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "type","message","uid","email","role","page","createdAt"
        ])
        && request.resource.data.message.size() <= 2000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------------- RESOURCES ----------------
    match /resources/{resourceId} {
      // Any authenticated user may read resources.
      // Client-side filtering in hub/page.tsx restricts which resources each
      // student actually sees. Using resource.data here would cause Firestore
      // to deny the unfiltered collection query with permission-denied.
      allow read: if isAuthed();

      allow create: if isTutorOrAdmin()
        && request.resource.data.keys().hasOnly([
          "title","subject","type","fileUrl","fileName","fileSize",
          "uploadedBy","uploadedByName","uploadedAt","assignedTo",
          "description","createdAt","updatedAt"
        ]);

      allow update: if isAdmin()
        || (isTutor() && resource.data.uploadedBy == request.auth.uid);

      allow delete: if isAdmin()
        || (isTutor() && resource.data.uploadedBy == request.auth.uid);
    }

  }
}